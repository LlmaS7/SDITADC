{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDITADC grid map v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "name",
    "grid",
    "points"
  ],
  "properties": {
    "format": {
      "const": "sditadc-map"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "grid": {
      "type": "object",
      "required": [
        "width",
        "height",
        "rows"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 3,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 3,
          "maximum": 256
        },
        "rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256,
            "pattern": "^[.#RO]+$"
          }
        }
      }
    },
    "points": {
      "type": "object",
      "required": [
        "starts",
        "parking",
        "pickups",
        "deliveries"
      ],
      "properties": {
        "starts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/position"
          }
        },
        "parking": {
          "$ref": "#/$defs/positions"
        },
        "pickups": {
          "$ref": "#/$defs/positions"
        },
        "deliveries": {
          "$ref": "#/$defs/positions"
        }
      }
    },
    "random_obstacles": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "region": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        }
      }
    },
    "source": {
      "type": "object"
    },
    "robots": {
      "type": "object",
      "properties": {
        "default_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pickups": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[PD][0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "aliases": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        },
        "deliveries": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[PD][0-9]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "aliases": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        },
        "shelves": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "pickup_id",
              "cells"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[A-Za-z0-9_-]{1,32}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "aliases": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "pickup_id": {
                "type": "string",
                "pattern": "^P[0-9]+$"
              },
              "cells": {
                "type": "array",
                "minItems": 1,
                "maxItems": 65536,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/position"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  }
}
